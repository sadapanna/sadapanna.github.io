rules_version = '2';

// Sadapanna — view-only public data.
// The website reads `projects` and `blogs` to render the site. Nothing on the
// site ever writes to Firestore: all content is seeded server-side with the
// Admin SDK (scripts/seed.mjs), which bypasses these rules. So every write
// from a client is denied, and reads are limited to the two public
// collections. Any collection not listed here is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else: no access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
